{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Programming Battle Jyanken",
  "mainBinaryName": "programming-battle-jyanken",
  "version": "0.1.0",
  "identifier": "com.kennedysilverdollar.programming-battle-jyanken",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Programming Battle Jyanken",
        "width": 1280,
        "height": 720,
        "minWidth": 640,
        "minHeight": 360,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
