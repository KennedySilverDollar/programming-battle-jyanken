{
  "name": "@pbj/server",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "サーバー権威のルーム対戦サーバー（Node.js + Effect）",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --external:effect --external:@effect/* --external:ws --outfile=dist/server.mjs",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@effect/platform": "^0.97.2",
    "@effect/platform-node": "^0.108.3",
    "@pbj/shared": "*",
    "effect": "^3.22.3",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2"
  }
}
